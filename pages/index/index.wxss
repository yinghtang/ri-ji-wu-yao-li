.page-index{ background:#fff; min-height:100vh; padding-bottom:24rpx; }
.hero-swiper{ width:100%; height:340rpx; margin-bottom:16rpx; }
.hero-img{ width:100%; height:100%; display:block; }

.recommend-card{ width:92%; margin:0 auto 18rpx; display:flex; gap:18rpx; align-items:center;
  background:#fff; border-radius:18rpx; padding:18rpx; box-shadow:0 8rpx 22rpx rgba(0,0,0,.06); }
.rec-img{ width:240rpx; height:240rpx; border-radius:16rpx; display:block; }
.rec-info{ flex:1; min-width:0; }
.rec-title{ font-size:24rpx; color:#A26A2A; margin-bottom:6rpx; }
.rec-name{ font-size:32rpx; color:#333; font-weight:700; }
.rec-desc{ margin-top:4rpx; color:#666; font-size:26rpx; line-height:1.4; }
.rec-tags{ margin-top:10rpx; display:flex; gap:10rpx; flex-wrap:wrap; }
.rec-tag{ background:#f5f0ea; color:#a87334; border-radius:10rpx; padding:6rpx 10rpx; font-size:22rpx; }
.rec-ctas{ display:flex; gap:12rpx; margin-top:12rpx; }
.rec-btn{ flex:0 0 260rpx; height:72rpx; line-height:72rpx; text-align:center;
  background:#D64D41; color:#fff; border:none; border-radius:36rpx; font-size:26rpx; }
.rec-link{ flex:0 0 180rpx; height:72rpx; line-height:72rpx; text-align:center;
  background:#f5f5f5; color:#666; border:none; border-radius:36rpx; font-size:24rpx; }

.section{ width:92%; margin:0 auto 18rpx; }
.sec-title{ font-size:28rpx; color:#333; font-weight:600; margin:10rpx 0 14rpx; }
.radar-wrap{ position:relative; }
wuxing-radar{ transform: scale(0.9); transform-origin: top center; display:block; }
.r-hint{ text-align:center; margin-top:6rpx; color:#777; font-size:24rpx; }

.calendar-card{ width:92%; margin:0 auto 16rpx; padding:18rpx; background:#fff; border-radius:16rpx;
  box-shadow:0 6rpx 20rpx rgba(0,0,0,.05); }
.cal-head{ display:flex; align-items:center; justify-content:space-between; }
.cal-left{ display:flex; flex-direction:column; gap:6rpx; }
.cal-date{ font-size:30rpx; color:#333; font-weight:700; }
.cal-gan{ font-size:24rpx; color:#666; }
.cal-toggle{ color:#D64D41; font-size:24rpx; }
.cal-brief{ display:flex; gap:12rpx; flex-wrap:wrap; margin-top:12rpx; }
.tag{ padding:8rpx 12rpx; border-radius:10rpx; font-size:22rpx; }
.tag-good{ background:#eaf6ee; color:#2f8f4e; }
.tag-bad{ background:#fdecec; color:#d64d41; }
.cal-detail{ margin-top:12rpx; }
.cal-grid{ display:grid; grid-template-columns:1fr 1fr; gap:8rpx; color:#888; font-size:22rpx; }

