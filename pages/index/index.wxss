

.p16{padding:16rpx*2}
.card{background:#fff;border-radius:28rpx;box-shadow:0 12rpx 32rpx rgba(0,0,0,.06);padding:32rpx}
.h1{font-size:34rpx;font-weight:600}
.sub{color:#666;font-size:26rpx}
.mt6{margin-top:12rpx}.mt4{margin-top:8rpx}.mt8{margin-top:16rpx}
.sp12{height:24rpx}.sp10{height:20rpx}.sp8{height:16rpx}
.row{display:flex;align-items:center;justify-content:space-between}
.name{font-size:30rpx;font-weight:600}
.hero{width:100%;height:360rpx;border-radius:20rpx}
.btn{background:#C9A24B;color:#fff;border-radius:9999rpx;padding:20rpx 0;margin-top:16rpx}
.tag{padding:6rpx 16rpx;border-radius:9999rpx;font-size:22rpx}
.tag-wood{background:#E7F2E5;color:#3d6d2f}
.tag-fire{background:#fde9e7;color:#b43b34}
.tag-earth{background:#fff4da;color:#9a6b24}
.tag-metal{background:#f2f2f2;color:#6b6b6b}
.tag-water{background:#e7eefb;color:#355a93}
