.page-index{ background:#fff; min-height:100vh; }

/* 顶部轮播：固定高度 + 下边距，防止与黄历重叠 */
.hero{ position:relative; z-index:0; }
.hero-swiper{ width:100%; height:360rpx; margin-bottom:16rpx; }
.hero-img{ width:100%; height:100%; display:block; }

/* 黄历卡片（吸顶） */
.calendar-card{
  width:92%; margin:0 auto 20rpx; padding:20rpx;
  background:#fff; border-radius:16rpx;
  box-shadow:0 6rpx 22rpx rgba(0,0,0,.06);
}
.sticky{ position:sticky; top:0; z-index:5; }

.c-head{ display:flex; align-items:center; gap:12rpx; margin-bottom:12rpx; flex-wrap:wrap;}
.c-date{ font-size:28rpx; color:#333; font-weight:600;}
.c-gan{ font-size:24rpx; color:#666;}
.c-sx{ font-size:24rpx; color:#9c9c9c; margin-left:auto;}

.c-tags{ display:flex; gap:12rpx; flex-wrap:wrap; margin-bottom:12rpx; }
.tag{ padding:8rpx 12rpx; border-radius:10rpx; font-size:22rpx; }
.tag-good{ background:#eaf6ee; color:#2f8f4e; }
.tag-bad{ background:#fdecec; color:#d64d41; }

.c-meta{ display:grid; grid-template-columns:1fr 1fr; gap:8rpx; color:#888; font-size:22rpx; }

/* 五行区块 */
.section{ width:92%; margin:0 auto 24rpx; }
.sec-title{ font-size:28rpx; color:#333; font-weight:600; margin:10rpx 0 16rpx; }

/* 推荐卡片 */
.recommend-card{
  width:92%; margin:10rpx auto 36rpx; display:flex; gap:16rpx; align-items:center;
  background:#fff; border-radius:16rpx; padding:16rpx; box-shadow:0 6rpx 22rpx rgba(0,0,0,.06);
}
.rec-img{ width:220rpx; height:220rpx; border-radius:14rpx; display:block; }
.rec-info{ flex:1; }
.rec-name{ font-size:30rpx; color:#333; font-weight:700; }
.rec-desc{ margin-top:6rpx; color:#666; font-size:26rpx; }
.rec-tags{ margin-top:10rpx; display:flex; gap:10rpx; flex-wrap:wrap; }
.rec-tag{ background:#f5f0ea; color:#a87334; border-radius:10rpx; padding:6rpx 10rpx; font-size:22rpx; }
