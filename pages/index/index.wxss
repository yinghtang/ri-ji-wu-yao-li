/* 页面与主视觉 */
.page.index{ position:relative; min-height:100vh; background:#F7F3EA; }
.hero-swiper{
  position:absolute; left:0; top:0; width:100%; height:520rpx; z-index:0;
  border-bottom-left-radius:28rpx; border-bottom-right-radius:28rpx; overflow:hidden;
}
.hero-bg{ width:100%; height:100%; display:block; }

/* 主体区块 */
.section{ position:relative; z-index:1; padding:28rpx; margin-top:420rpx; }
.h1{ font-size:34rpx; font-weight:600; margin-bottom:16rpx; }

/* 推荐卡片 */
.card{ position:relative; overflow:hidden; border-radius:20rpx; margin-bottom:20rpx; }
.card-bg{ position:absolute; inset:0; filter:brightness(1.02); opacity:.95; }
.prod{ width:100%; height:360rpx; display:block; position:relative; z-index:1; }
.name{
  position:absolute; left:24rpx; bottom:24rpx; z-index:2;
  color:#222; background:rgba(255,255,255,.78); padding:6rpx 14rpx;
  border-radius:9999rpx; font-size:26rpx;
}
.tag{
  position:absolute; right:24rpx; bottom:24rpx; z-index:2;
  padding:6rpx 16rpx; border-radius:9999rpx; font-size:22rpx; color:#fff;
}
.tag.water{ background:#193C7A; }
.tag.earth{ background:#C98C2B; }

/* 按钮 */
.btn{ width:100%; border-radius:9999rpx; background:#c2453d; color:#fff; padding:22rpx 0; margin-top:6rpx; }
