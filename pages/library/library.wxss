.p12{padding:24rpx}
.h1{font-size:34rpx;font-weight:600}
.sub{color:#666;font-size:26rpx}
.mt6{margin-top:12rpx}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:20rpx;margin-top:16rpx}
.card{background:#fff;border-radius:24rpx;box-shadow:0 8rpx 24rpx rgba(0,0,0,.06);padding:20rpx}
.thumb{width:100%;height:260rpx;border-radius:16rpx}
.dim{opacity:.35;filter:blur(.2px)}
.row{display:flex;align-items:center;justify-content:space-between}
.name{font-size:28rpx;font-weight:600}
.tag{padding:6rpx 14rpx;border-radius:9999rpx;font-size:22rpx}
.tag-wood{background:#E7F2E5;color:#3d6d2f}
.tag-fire{background:#fde9e7;color:#b43b34}
.tag-earth{background:#fff4da;color:#9a6b24}
.tag-metal{background:#f2f2f2;color:#6b6b6b}
.tag-water{background:#e7eefb;color:#355a93}
