.page.lib{ background:#F7F3EA; padding:24rpx; }
.grid{ display:grid; grid-template-columns:1fr 1fr; gap:20rpx; }
.card{ position:relative; border-radius:20rpx; overflow:hidden; }
.card-bg{ position:absolute; inset:0; opacity:.95; }
.prod{ position:relative; z-index:1; width:100%; height:300rpx; }
.dim{ opacity:.35; filter:grayscale(.15); }
