.page-lib{ background:#fff; padding:18rpx 0; }
.card{ width:92%; margin:0 auto 18rpx; background:#fff; border-radius:16rpx; overflow:hidden; box-shadow:0 6rpx 20rpx rgba(0,0,0,.06); }

/* 新增：图片容器 + 右上角悬浮键 */
.img-wrap{ position:relative; }
.pic{ width:100%; height:320rpx; display:block; }
.wish-fab{
  position:absolute; right:14rpx; top:14rpx;
  width:64rpx; height:64rpx; line-height:64rpx; border-radius:50%;
  background:rgba(214,77,65,.88); color:#fff; font-size:40rpx; text-align:center;
  border:none; padding:0; box-shadow:0 6rpx 16rpx rgba(214,77,65,.35);
}
.meta{ padding:16rpx; }
.name{ font-size:30rpx; color:#333; font-weight:700; }
.desc{ margin-top:6rpx; color:#666; font-size:26rpx; }
.tags{ display:flex; gap:10rpx; flex-wrap:wrap; margin:10rpx 0; }
.tag{ background:#f5f0ea; color:#a87334; border-radius:10rpx; padding:6rpx 10rpx; font-size:22rpx; }
.btn{ width:200rpx; height:64rpx; line-height:64rpx; border:none; border-radius:32rpx; background:#D64D41; color:#fff; font-size:26rpx; }
