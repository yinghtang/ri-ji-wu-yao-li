<view class="page-lib">
  <block wx:for="{{items}}" wx:key="name">
    <view class="card">
      <view class="img-wrap">
        <image class="pic" src="{{item.img}}" mode="aspectFill"/>
        <button class="wish-fab" data-name="{{item.name}}" bindtap="wish">＋</button>
      </view>
      <view class="meta">
        <view class="name">{{item.name}}</view>
        <view class="desc">{{item.desc}}</view>
        <view class="tags">
          <block wx:for="{{item.tags}}" wx:key="*this">
            <text class="tag">{{item}}</text>
          </block>
        </view>
        <!-- 原“想要”按钮删除 -->
      </view>
    </view>
  </block>
</view>
