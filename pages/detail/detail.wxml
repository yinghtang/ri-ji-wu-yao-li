<view class="page detail">
  <view class="hero">
    <image class="bg" src="../../assets/detail-hero.jpg" mode="aspectFill"/>
    <image class="prod" src="{{p.img}}" mode="aspectFit"/>
  </view>

  <view class="info">
    <view class="title">{{p.name || '手串名称'}}</view>
    <view class="row">
      <button class="btn ghost" bindtap="unlock" wx:if="{{!owned}}">解锁</button>
      <button class="btn" bindtap="buy">前往购买</button>
    </view>
  </view>
</view>
