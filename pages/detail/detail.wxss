.page.detail{ background:#F7F3EA; }
.hero{ position:relative; height:520rpx; overflow:hidden; }
.hero .bg{ position:absolute; inset:0; filter:brightness(1.05); }
.hero .prod{ position:relative; z-index:1; width:100%; height:100%; }
.info{ padding:28rpx; }
.title{ font-size:36rpx; font-weight:600; margin-bottom:16rpx; }
.row{ display:flex; gap:16rpx; }
.btn{ flex:1; padding:22rpx 0; border-radius:9999rpx; background:#c2453d; color:#fff; }
.btn.ghost{ background:#fff; color:#c2453d; border:1px solid #c2453d; }
