.wuxing-radar { display:flex; flex-direction:column; align-items:center; padding:12rpx 0; }
.radar-canvas { width: 520rpx; height: 520rpx; } /* 旧接口走 CSS 尺寸 */
.legend { margin-top: 12rpx; width: 520rpx; display:grid; grid-template-columns:1fr 1fr 1fr; row-gap:8rpx; }
.legend-item { display:flex; justify-content:space-between; padding:8rpx 12rpx; border:1rpx solid #eee; border-radius:8rpx; font-size:26rpx; }
